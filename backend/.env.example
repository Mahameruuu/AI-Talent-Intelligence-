# Copy to .env and adjust. Never commit .env.
FLASK_ENV=development
DATABASE_URL=postgresql+psycopg://localhost/xorca_ti
TEST_DATABASE_URL=postgresql+psycopg://localhost/xorca_ti_test
# Private storage for uploaded CVs (outside any public/static folder)
DOCUMENT_STORAGE_DIR=./storage/documents
MAX_UPLOAD_MB=10
# Frontend origin, used for CORS and for building interview invitation links
FRONTEND_URL=http://localhost:5173
COMPANY_NAME=XORCA
# LLM (optional). Without credentials the app runs with rule-based fallbacks only.
# Review the provider's data-retention policy before sending real CVs (CVs are personal data, UU PDP).
#   LLM_PROVIDER=anthropic  -> Claude, uses ANTHROPIC_API_KEY, LLM_MODEL e.g. claude-opus-5-5
#   LLM_PROVIDER=groq       -> free tier, LLM_API_KEY from console.groq.com, LLM_MODEL e.g. llama-3.3-70b-versatile
#   LLM_PROVIDER=ollama     -> local & free, no key, LLM_MODEL e.g. qwen2.5:7b (data stays on your server)
#   LLM_PROVIDER=openrouter / gemini / openai_compatible (+ LLM_BASE_URL)
#   LLM_PROVIDER=none       -> disable the LLM
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=claude-opus-5-5
# Optional backup provider, used automatically when the primary fails (free quota exhausted, error, timeout).
# Example: LLM_FALLBACK_PROVIDER=gemini, LLM_FALLBACK_API_KEY from aistudio.google.com, LLM_FALLBACK_MODEL=gemini-2.5-flash
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_ENABLE_CV_EXTRACTION=true
# Interviewer voice (server text-to-speech via Gemini TTS). Default: "gemini" when a Gemini key is available
# (TTS_API_KEY, else LLM_API_KEY when LLM_PROVIDER=gemini, else LLM_FALLBACK_API_KEY when the fallback is gemini);
# "none" uses only the browser's own speech synthesis. Interviewer question text is sent to Google for speech.
TTS_PROVIDER=
TTS_API_KEY=
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_FALLBACK_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore
TTS_TIMEOUT_SECONDS=30
# Private audio cache (never served statically)
TTS_CACHE_DIR=storage/tts
# Email for AI interview invitations (optional). Without SMTP_HOST, emails are logged as "not_configured"
# and HR gets the links to share manually. Gmail example: smtp.gmail.com, port 587, TLS, an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=
MAIL_FROM_NAME=XORCA Recruitment
# Optional sentence-transformers model for semantic matching (requires the package)
EMBEDDING_MODEL=
WORKER_MAX_WORKERS=2
# Public application form: max submissions per client IP per hour
FORM_SUBMISSIONS_PER_IP_PER_HOUR=30
# Automatic AI-interview invitations to the top N screened applicants, per job either at AUTO_INVITE_HOUR
# (WIB / TIMEZONE) on the day after the deadline (closes_on) or right after applications close ("on_close").
# The scheduler checks every AUTO_INVITE_INTERVAL_SECONDS. Set false to disable the scheduler.
AUTO_INVITE_ENABLED=true
AUTO_INVITE_HOUR=8
AUTO_INVITE_INTERVAL_SECONDS=60
# Data retention: the rules (on/off, months after the job closes, keep hired) are set by an admin in
# Settings → Data retention. The scheduler applies them once a day at RETENTION_HOUR (WIB / TIMEZONE).
RETENTION_SCHEDULER_ENABLED=true
RETENTION_HOUR=2
# Send Strict-Transport-Security even when TLS is terminated by a reverse proxy (production behind HTTPS).
HSTS_ENABLED=false
